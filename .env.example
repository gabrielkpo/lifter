# Copy to .env. Never commit the real values.
# Local Postgres database for Lifter (created with: createdb lifter)
DATABASE_URL=postgresql:///lifter
# garmin-mcp-remote, reached on the loopback or a private network only
GARMIN_MCP_URL=http://127.0.0.1:8080/mcp
# The MCP_BEARER_TOKEN of garmin-mcp-remote
GARMIN_MCP_TOKEN=
# Pause between two Garmin calls, to respect Garmin Connect limits
SYNC_DELAY_SECONDS=1.0
# Agents (step 3). The Mistral API key stays here, never in the code or the logs
MISTRAL_API_KEY=
# Model of the agents (Mistral API name)
LIFTER_MODEL=mistral-small-latest
# Language of the coach's summaries and rationales
LIFTER_COACH_LANGUAGE=English
# What the agents send to the LLM: indicators (default: structured log and computed
# indicators, no free text) or full (adds session notes, deviations and week reviews)
LIFTER_LLM_CONTEXT=indicators
# Throwaway database of the evaluation bench (emptied before every scenario; its name must
# start with lifter_bench): createdb lifter_bench
BENCH_DATABASE_URL=postgresql://localhost:5433/lifter_bench
# API of the app (uv run lifter-api), always on 127.0.0.1
LIFTER_API_PORT=8000
# Bearer token required on every request when set (always required when hosted)
LIFTER_API_TOKEN=
# App origins allowed to call the API from a browser, comma-separated
LIFTER_APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Tests: a local Postgres 18 (the hosted version), here next to another major on port 5433
TEST_DATABASE_URL=postgresql://localhost:5433/postgres
