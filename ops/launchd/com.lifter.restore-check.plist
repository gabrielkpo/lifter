<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by ops/install.sh, which replaces __OPS_DIR__ and __LOG_DIR__. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lifter.restore-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__OPS_DIR__/lifter-restore-check.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>30</integer></dict>
  <!-- Logs readable by this user only (63 = octal 077). -->
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/com.lifter.restore-check.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/com.lifter.restore-check.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
