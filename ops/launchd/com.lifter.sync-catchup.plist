<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by ops/install.sh, which replaces __OPS_DIR__ and __LOG_DIR__. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lifter.sync-catchup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__OPS_DIR__/lifter-sync.sh</string>
    <string>--catch-up</string>
  </array>
  <!-- Every hour; the script syncs only when the Mac is in use and the last sync is old. -->
  <key>StartInterval</key>
  <integer>3600</integer>
  <!-- Logs readable by this user only (63 = octal 077). -->
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/com.lifter.sync-catchup.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/com.lifter.sync-catchup.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
