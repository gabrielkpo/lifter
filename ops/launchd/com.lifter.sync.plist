<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by ops/install.sh, which replaces __OPS_DIR__ and __LOG_DIR__. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lifter.sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__OPS_DIR__/lifter-sync.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/com.lifter.sync.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/com.lifter.sync.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
