# Copy to .env.local. Read by the app's server only (app/api/[...path]/route.ts), never sent to
# the browser.
# The Lifter API: locally `uv run lifter-api`; on Vercel, the lifter-api deployment.
LIFTER_API_URL=http://127.0.0.1:8000
# Bearer token of the API (required when the API is hosted, optional locally)
LIFTER_API_TOKEN=
# Vercel "Protection Bypass for Automation" secret of the lifter-api project (hosted only)
LIFTER_API_BYPASS=
# The app's own sign-in (proxy.ts, lib/session.ts), required in every environment: without
# both, every page and /api call is refused. The passphrase is typed on the sign-in page (12
# characters at least); the session key signs the cookies (32 characters at least, e.g.
# `openssl rand -base64 32`). Changing either signs every device out.
LIFTER_APP_PASSPHRASE=
LIFTER_SESSION_KEY=
